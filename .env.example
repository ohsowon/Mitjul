# 밑줄(mitjul) 환경변수 템플릿
# 이 파일을 .env로 복사한 뒤 값을 채워 사용한다. .env는 절대 커밋하지 않는다. (CLAUDE.md §7)
#   cp .env.example .env
#
# 값은 항상 비워 둔 채로 커밋한다.

# ── 실행 프로필 (dev | prod) ───────────────────────────────
SPRING_PROFILES_ACTIVE=

# ── DB (prod 프로필에서 사용) ──────────────────────────────
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ── JWT (마일스톤 2) ───────────────────────────────────────
# JWT_SECRET: HS256 서명용, 32자(256비트) 이상의 임의 문자열
# JWT_ACCESS_TOKEN_EXPIRE_MS: 액세스 토큰 만료(밀리초). 예) 3600000 = 1시간
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MS=

# ── OCR API (마일스톤 4) ───────────────────────────────────
OCR_PROVIDER=
OCR_API_URL=
OCR_API_KEY=
OCR_SECRET_KEY=

# ── 도서 검색 API (마일스톤 5) ─────────────────────────────
BOOK_SEARCH_PROVIDER=
BOOK_SEARCH_API_URL=
BOOK_SEARCH_CLIENT_ID=
BOOK_SEARCH_CLIENT_SECRET=

# ── 이미지 스토리지 (마일스톤 4) ───────────────────────────
STORAGE_TYPE=
STORAGE_LOCAL_PATH=
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── CORS 허용 오리진 (마일스톤 7) ──────────────────────────
CORS_ALLOWED_ORIGINS=
